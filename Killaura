local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart")
end)

local Config = {
    KillAura = false,
    Range = 60,
    Delay = 0.05,
}

-- // หา swing remote จาก Workspace.PlayerName
local function GetSwingRemote()
    -- หาใน Workspace.SSSDSD231 ตรงๆ
    local playerFolder = workspace:FindFirstChild(LocalPlayer.Name)
    if playerFolder then
        for _, child in pairs(playerFolder:GetChildren()) do
            local swing = child:FindFirstChild("swing", true)
            if swing and swing:IsA("RemoteEvent") then
                return swing
            end
        end
    end
    -- fallback: หาใน Character
    if Character then
        for _, child in pairs(Character:GetChildren()) do
            local swing = child:FindFirstChild("swing", true)
            if swing and swing:IsA("RemoteEvent") then
                return swing
            end
        end
    end
    return nil
end

-- // หา abilityCast
local function GetAbilityRemote()
    local rs = game:GetService("ReplicatedStorage")
    local remotes = rs:FindFirstChild("remotes")
    if remotes then
        return remotes:FindFirstChild("abilityCast")
    end
    return nil
end

-- // Kill Aura Loop
local function KillAuraLoop()
    while Config.KillAura do
        if Character and HumanoidRootPart then
            local swingRemote = GetSwingRemote()
            local abilityRemote = GetAbilityRemote()

            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model")
                and obj ~= Character
                and obj:FindFirstChildOfClass("Humanoid")
                and obj:FindFirstChild("HumanoidRootPart") then
                    local mobHuman = obj:FindFirstChildOfClass("Humanoid")
                    local mobHRP = obj.HumanoidRootPart

                    if mobHuman.Health > 0 then
                        local dist = (HumanoidRootPart.Position - mobHRP.Position).Magnitude
                        if dist <= Config.Range then
                            -- tp ไปใกล้ mob
                            HumanoidRootPart.CFrame = mobHRP.CFrame * CFrame.new(0, 0, -3)
                            task.wait(0.05)
                            -- swing
                            if swingRemote then
                                pcall(function()
                                    swingRemote:FireServer()
                                end)
                            end
                            -- ability
                            if abilityRemote then
                                pcall(function()
                                    abilityRemote:FireServer()
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(Config.Delay)
    end
end

